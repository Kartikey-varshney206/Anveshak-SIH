# ==========================================
# CrimeGraph AI — Environment Configuration
# ==========================================

# 1. Databricks Lakehouse Configuration
# (If omitted, system automatically operates in Zero-Config Local Medallion Lakehouse Mode)
DATABRICKS_HOST=https://your-databricks-workspace.cloud.databricks.com
DATABRICKS_HTTP_PATH=/sql/1.0/endpoints/xxxxxxxxxxxx
DATABRICKS_TOKEN=dapi_your_databricks_personal_access_token
DATABRICKS_CATALOG=crimegraph_lakehouse
DATABRICKS_SCHEMA=gold

# 2. Graph Database (Neo4j) Configuration
# (If omitted, system automatically uses in-memory NetworkX MultiDiGraph engine)
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_secure_neo4j_password

# 3. Entire Graph Intelligence & Reasoning Integration
# (If omitted, system automatically uses CrimeGraph Local Entire Graph Reasoning Adapter)
ENTIRE_API_KEY=entire_api_key_placeholder

# 4. AI / LLM Extraction Configuration
# (If omitted, system operates deterministic rule-based and regex span extraction)
LLM_API_KEY=your_llm_api_key_here
OPENAI_API_KEY=
GEMINI_API_KEY=

# 5. Server Environment
ENVIRONMENT=development
PORT=8000
HOST=127.0.0.1
DEBUG=True
